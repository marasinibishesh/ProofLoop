# Copy this file to .env and fill in your own values. Never commit .env.
# Without these values Proofloop runs in sample mode.

# --- Meterless Nightshift (primary AI provider, OpenAI-compatible) ---
# Nightshift -> Console shows the runtime token. The placeholder "rt-local" is rejected.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=replace-with-your-runtime-token
# Pin a concrete NVIDIA model; meterless/auto can silently route elsewhere.
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_APP=proofloop

# --- Zetaris (data layer, Lightning SQL over REST) ---
# API key: Zetaris Console -> Management -> API Tokens. Org ID: shown in the Zetaris UI.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=replace-with-your-org-id
ZETARIS_API_KEY=replace-with-your-api-key
# Folder Zetaris can read files from, as Zetaris sees it (inside its engine / container).
ZETARIS_SHARED_PATH=/home/zetaris/customer-data/shared
# The same folder as seen from THIS computer (e.g. the Docker volume on your disk). `npm run ingest`
# copies evidence.csv here. Leave empty if you copy the file yourself.
ZETARIS_IMPORT_DIR=

# Lightning table that holds the evidence chunks (see docs: npm run ingest)
ZETARIS_EVIDENCE_TABLE=PROOFLOOP.evidence

# --- Optional: voice questions (ElevenLabs Speech-to-Text) ---
# Leave empty to hide the mic button. Only transcribes; reasoning stays on Nemotron via Nightshift.
ELEVENLABS_API_KEY=

# --- Proofloop ---
# Folder to read (subfolders too): .txt .md .pdf .csv .ics. Default: the bundled sample. ~ = home folder.
# Example: PROOFLOOP_DOCS=~/Documents/ICAAD   (keep real/private folders OUT of this repo)
PROOFLOOP_DOCS=samples/conference
PROOFLOOP_PORT=4317

# The NVIDIA API key does NOT go here: add it in Nightshift -> Setup -> Providers -> NVIDIA.
